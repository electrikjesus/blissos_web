.blis{background-size:cover!important;background-position:50%!important;background-repeat:no-repeat!important}.opt{transition:all .4s ease}@media only screen and (min-width:768px){.opt{width:12vw;max-width:120px;margin-right:1.25rem}.opt.open{width:40vw!important;max-width:730px!important}.flx{flex-direction:row}}@media only screen and (max-width:767px){.opt{width:auto;height:120px;margin-left:1.25rem;margin-right:1.25rem;margin-bottom:2rem}.opt.open{height:340px!important}.flx{flex-direction:column}}.opt.open *{visibility:visible!important;opacity:1!important}.opt *{visibility:collapse;opacity:0;transition:opacity .2s linear,visibility .5s linear}.blissel section{display:flex;width:90%;position:relative;-webkit-user-select:none;-moz-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent;z-index:1;margin:0 auto;font-size:90%;border:1px solid #fff;border-radius:3px;color:#fff}.blissel section>input{display:none}.blissel section>input:checked+label{color:#000}.blissel section>input:nth-of-type(1):checked~label:last-of-type:before{transform:translateX(calc(0% + 0px))}.blissel section>input:nth-of-type(2):checked~label:last-of-type:before{transform:translateX(calc(100% + 0px))}.blissel section label{flex:1;text-align:center;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;cursor:pointer;padding:6px 3px;transition:color 250ms cubic-bezier(0,.95,.38,.98)}.blissel section label:last-of-type:before{content:"";display:block;max-width:calc(50% - 0px);margin:0;position:absolute;top:0;right:0;bottom:0;left:0;z-index:-1;transform:translateX(0)}.blissel section label:before{background:#fff;transition:all 250ms cubic-bezier(0,.95,.38,.98)}.blissel section label:not(:last-child){border-right:1px solid #fff}