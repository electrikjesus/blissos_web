@import url("https://fonts.googleapis.com/css2?family=Rubik:wght@400;700&display=swap");
* {
  font-family: 'Rubik', sans-serif; }

#mainBG {
  background-image: url("/images/pages/bliss16_colors.png "); }

*.dark #mainBG {
  background-image: url("/images/pages/bliss16_colors_dark.png "); }

.crv1 {
  clip-path: url(#mask1); }

