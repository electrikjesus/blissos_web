  clip-path: url(#mask2); }

.crv3 {
  clip-path: url(#mask3); }

.crv4 {
  clip-path: url(#mask4); }

.crv5 {
  clip-path: url(#mask5); }

.crv6 {
  clip-path: url(#mask6); }
