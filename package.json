{
  "name": "blissweb",
  "version": "0.1.1",
  "description": "Website for BlissOS",
  "main": "server.js",
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "alpinejs": "^3.14.7",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^3.4.16",
    "nodemon": "^3.0.2",
    "test": "^3.3.0"
  },
  "scripts": {
    "start": "concurrently \"npm run watch:css\" \"npm run dev\"",
    "dev": "nodemon server.js",
    "watch:css": "tailwindcss -i ./assets/css/main.css -o ./assets/css/style.css --watch",
    "build:css": "tailwindcss -i ./assets/css/main.css -o ./assets/css/style.css --minify",
    "build": "npm run build:css && node server.js",
    "production": "NODE_ENV=production node server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nusserstudios/tailbliss.git"
  },
  "keywords": [
    "hugo",
    "tailwind",
    "tailwindcss",
    "alpinejs",
    "minimal",
    "responsive",
    "light mode",
    "dark mode",
    "hugo blog",
    "categories",
    "tags"
  ],
  "author": "GiftShower_",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/nusserstudios/tailbliss/issues"
  },
  "homepage": "https://github.com/nusserstudios/tailbliss",
  "dependencies": {
    "@splidejs/splide": "^4.1.4",
    "express": "^4.18.2",
    "ejs": "^3.1.9"
  }
}
