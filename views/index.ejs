<!DOCTYPE html>
<html lang="en">

<head>
    <meta http-equiv="Content-Type" content="text/html" charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="manifest" href="/favicon/site.webmanifest">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">
    
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    
    <script src="https://kit.fontawesome.com/bc56c2b7b7.js" crossorigin="anonymous"></script>
    <script>
        // On page load or when changing themes, best to add inline in `head` to avoid FOUC
        if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark')
        }
    </script>

    <link rel="stylesheet" href="/assets/css/style.css" media="all">
    <link rel="stylesheet" href="/assets/css/splide-sea-green.css" media="all">
</head>

<body class="bg-white dark:bg-gray-900">
    <%- include('partials/nav') %>
    
    <main class="dark:from-[#110018] dark:to-[#732a35]">
        <div class="bg-cover bg-center h-full overflow-hidden" style="margin-top: -4.5rem; padding-top: 4.5rem" id="mainBG">
            <div class="max-w-screen-xl px-4 py-8 lg:py-16 mx-auto">
                <div class="grid items-center gap-8 lg:mb-8 mb-48 lg:gap-12 lg:grid-cols-12 h-screen -mt-[144px]">
                    <div class="mt-48 lg:mt-0 col-span-6 px-4 text-center sm:mb-6 lg:text-left lg:mb-0">
                        <h1 class="mb-2 text-5xl font-extrabold leading-none tracking-tight text-gray-900 md:text-6xl xl:text-7xl dark:text-white">
                            BlissOS</h1>
                        <h2 class="pb-2 text-3xl font-light text-gray-800 dark:text-gray-300 md:text-4xl">
                            Android for your PC
                        </h2>
                        <p class="max-w-xl mx-auto mb-6 font-normal text-gray-900 lg:mx-0 xl:mb-2 md:text-lg xl:text-xl dark:text-gray-50">
                            An Android-based open source OS that incorporates many optimizations, features, and that supports many more devices.
                        </p>
                        <a onclick="window.scrollTo({top: document.getElementById('dlmenu').offsetTop, behavior: 'smooth'})" class="font-bold text-2xl text-indigo-400 hover:text-indigo-600 cursor-pointer">
                            Download Now&nbsp&rarr;
                        </a>
                    </div>
                    <div class="col-span-6">
                        <img src="/assets/images/pages/bliss_pc_home.jpg"
                             width="100%" alt="BlissOS Home"
                             class="w-full max-w-xl mx-auto border-gray-950 border-[16px] rounded-lg outline-gray-500 outline-2 outline"/>
                    </div>
                </div>
            </div>
            <div class="h-72 min-w-[1440px] bg-gradient-to-b from-transparent to-[#EBBBD3] dark:to-[#18040A] -mt-32"></div>
        </div>

        <!-- Downloads Section -->
        <div id="dlmenu" class="text-center relative bg-[#F5E4DF] dark:bg-[#3d0626] dark:text-white overflow-hidden">
            <h2 class="text-4xl font-black tracking-tight mb-12 pt-16">BlissOS Downloads</h2>
            
            <div class="max-w-4xl mx-auto px-4 pb-16">
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg">
                        <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">GApps Build</h3>
                        <p class="text-gray-600 dark:text-gray-300 mb-4">Includes Google Play Store and services</p>
                        <a href="#" class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 transition-colors">Download</a>
                    </div>
                    <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg">
                        <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">FOSS Build</h3>
                        <p class="text-gray-600 dark:text-gray-300 mb-4">Open source alternatives only</p>
                        <a href="#" class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 transition-colors">Download</a>
                    </div>
                    <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg">
                        <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">Vanilla Build</h3>
                        <p class="text-gray-600 dark:text-gray-300 mb-4">Minimal installation</p>
                        <a href="#" class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 transition-colors">Download</a>
                    </div>
                </div>
            </div>
            
            <p class="pt-12 m-4">*<a href="http://docs.blissos.org" class="hover:text-indigo-600 dark:hover:text-indigo-500">Check our Documentation</a> to see which devices these builds are supported</p>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>

</html>