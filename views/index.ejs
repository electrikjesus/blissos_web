<!DOCTYPE html>
<html lang="en">

<head>
    <meta http-equiv="Content-Type" content="text/html" charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png">
    <link rel="manifest" href="/favicon/site.webmanifest">
    <meta name="msapplication-TileColor" content="#da532c">
    <meta name="theme-color" content="#ffffff">
    
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    
    <script src="https://kit.fontawesome.com/bc56c2b7b7.js" crossorigin="anonymous"></script>
    <script>
        // On page load or when changing themes, best to add inline in `head` to avoid FOUC
        if (localStorage.getItem('color-theme') === 'dark' || (!('color-theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark')
        }
    </script>

    <link rel="stylesheet" href="/assets/css/style.css" media="all">
    <link rel="stylesheet" href="/assets/css/splide-sea-green.css" media="all">
</head>

<body class="bg-white dark:bg-gray-900">
    <%- include('partials/nav') %>
    
    <main class="dark:from-[#110018] dark:to-[#732a35]">
        <div class="bg-cover bg-center h-full overflow-hidden" style="margin-top: -4.5rem; padding-top: 4.5rem" id="mainBG">
            <div class="max-w-screen-xl px-4 py-8 lg:py-16 mx-auto">
                <div class="grid items-center gap-8 lg:mb-8 mb-48 lg:gap-12 lg:grid-cols-12 h-screen -mt-[144px]">
                    <div class="mt-48 lg:mt-0 col-span-6 px-4 text-center sm:mb-6 lg:text-left lg:mb-0">
                        <h1 class="mb-2 text-5xl font-extrabold leading-none tracking-tight text-gray-900 md:text-6xl xl:text-7xl dark:text-white">
                            BlissOS</h1>
                        <h2 class="pb-2 text-3xl font-light text-gray-800 dark:text-gray-300 md:text-4xl">
                            Android for your PC
                        </h2>
                        <p class="max-w-xl mx-auto mb-6 font-normal text-gray-900 lg:mx-0 xl:mb-2 md:text-lg xl:text-xl dark:text-gray-50">
                            An Android-based open source OS that incorporates many optimizations, features, and that supports many more devices.
                        </p>
                        <a onclick="window.scrollTo({top: document.getElementById('dlmenu').offsetTop, behavior: 'smooth'})" class="font-bold text-2xl text-indigo-400 hover:text-indigo-600 cursor-pointer">
                            Download Now&nbsp&rarr;
                        </a>
                    </div>
                    <div class="col-span-6">
                        <img src="/assets/images/pages/bliss_pc_home.jpg"
                             width="100%" alt="BlissOS Home"
                             class="w-full max-w-xl mx-auto border-gray-950 border-[16px] rounded-lg outline-gray-500 outline-2 outline"/>
                    </div>
                </div>
            </div>
            <div class="h-72 min-w-[1440px] bg-gradient-to-b from-transparent to-[#EBBBD3] dark:to-[#18040A] -mt-32"></div>
        </div>

        <!-- Downloads Section -->
        <div id="dlmenu" class="text-center relative bg-[#F5E4DF] dark:bg-[#3d0626] dark:text-white overflow-hidden">
            <h2 class="text-4xl font-black tracking-tight mb-4 pt-16">BlissOS Downloads</h2>
            
            <!-- Version Info -->
            <% if (downloads && downloads.metadata && downloads.metadata.latestVersion) { %>
                <div class="mb-8">
                    <p class="text-lg text-gray-700 dark:text-gray-300">
                        Latest Version: <span class="font-semibold"><%= downloads.metadata.latestVersion %></span>
                        <% if (downloads.metadata.basedOn) { %>
                            • Based on <%= downloads.metadata.basedOn %>
                        <% } %>
                    </p>
                    <% if (downloads.metadata.lastUpdated) { %>
                        <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                            Last Updated: <%= new Date(downloads.metadata.lastUpdated).toLocaleDateString('en-US', { 
                                year: 'numeric', 
                                month: 'long', 
                                day: 'numeric' 
                            }) %>
                        </p>
                    <% } %>
                </div>
            <% } %>
            
            <div class="max-w-7xl mx-auto px-4 pb-16">
                <% if (downloads && downloads.builds && downloads.builds.length > 0) { %>
                    <!-- Downloads Cards in Columns Layout -->
                    <div class="columns-1 md:columns-2 xl:columns-3 gap-8 space-y-8">
                        <% downloads.builds.forEach(build => { %>
                            <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300 overflow-hidden break-inside-avoid mb-8 inline-block w-full">
                                <!-- Category Badge -->
                                <div class="p-4 pb-0">
                                    <% if (build.category === 'recommended') { %>
                                        <span class="inline-block bg-indigo-100 dark:bg-indigo-900 text-indigo-800 dark:text-indigo-200 text-xs font-semibold px-3 py-1 rounded-full">
                                            Recommended
                                        </span>
                                    <% } else if (build.category === 'privacy') { %>
                                        <span class="inline-block bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs font-semibold px-3 py-1 rounded-full">
                                            Privacy Focused
                                        </span>
                                    <% } else if (build.category === 'minimal') { %>
                                        <span class="inline-block bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 text-xs font-semibold px-3 py-1 rounded-full">
                                            Minimal
                                        </span>
                                    <% } %>
                                </div>
                                
                                <!-- Card Content -->
                                <div class="p-6">
                                    <h3 class="text-xl font-bold mb-3 text-gray-900 dark:text-white"><%= build.title %></h3>
                                    <p class="text-gray-600 dark:text-gray-300 mb-4 text-sm"><%= build.description %></p>
                                    
                                    <!-- Build Info -->
                                    <div class="space-y-2 mb-4">
                                        <div class="flex justify-between text-sm">
                                            <span class="text-gray-500 dark:text-gray-400">Version:</span>
                                            <span class="text-gray-900 dark:text-white font-medium"><%= build.version %></span>
                                        </div>
                                        <div class="flex justify-between text-sm">
                                            <span class="text-gray-500 dark:text-gray-400">Size:</span>
                                            <span class="text-gray-900 dark:text-white font-medium"><%= build.size %></span>
                                        </div>
                                    </div>
                                    
                                    <!-- Key Features -->
                                    <div class="mb-6">
                                        <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Key Features:</h4>
                                        <ul class="space-y-1">
                                            <% build.features.slice(0, 2).forEach(feature => { %>
                                                <li class="flex items-start text-sm text-gray-600 dark:text-gray-400">
                                                    <span class="inline-block w-1.5 h-1.5 bg-green-500 rounded-full mt-2 mr-2 flex-shrink-0"></span>
                                                    <%= feature %>
                                                </li>
                                            <% }); %>
                                            <% if (build.features.length > 2) { %>
                                                <li class="text-xs text-gray-500 dark:text-gray-400 italic pl-3">
                                                    + <%= build.features.length - 2 %> more features
                                                </li>
                                            <% } %>
                                        </ul>
                                    </div>
                                    
                                    <!-- Download Button -->
                                    <div class="space-y-3">
                                        <% if (build.supported) { %>
                                            <a href="<%= build.downloadUrl %>" 
                                               class="block w-full bg-indigo-600 text-white px-4 py-3 rounded-lg hover:bg-indigo-700 transition-colors text-center font-medium">
                                                Download <%= build.title %>
                                            </a>
                                        <% } else { %>
                                            <button disabled 
                                                    class="block w-full bg-gray-400 text-white px-4 py-3 rounded-lg cursor-not-allowed text-center font-medium">
                                                Currently Unavailable
                                            </button>
                                        <% } %>
                                        
                                        <button onclick="showDownloadDetails('<%= build.id %>')" 
                                                class="block w-full text-indigo-600 dark:text-indigo-400 hover:underline text-sm py-2">
                                            View Full Details
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                    
                    <!-- Download Details Modal (Hidden by default) -->
                    <div id="download-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center p-4">
                        <div class="bg-white dark:bg-gray-800 rounded-lg max-w-2xl w-full max-h-[90vh] overflow-y-auto">
                            <div class="p-6">
                                <div class="flex justify-between items-center mb-4">
                                    <h3 id="modal-title" class="text-2xl font-bold text-gray-900 dark:text-white"></h3>
                                    <button onclick="closeDownloadModal()" class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                        </svg>
                                    </button>
                                </div>
                                <div id="modal-content"></div>
                            </div>
                        </div>
                    </div>
                    
                    <script>
                        function showDownloadDetails(buildId) {
                            const builds = <%- JSON.stringify(downloads.builds) %>;
                            const build = builds.find(b => b.id === buildId);
                            
                            if (build) {
                                document.getElementById('modal-title').textContent = build.title;
                                document.getElementById('modal-content').innerHTML = `
                                    <div class="space-y-4">
                                        <p class="text-gray-600 dark:text-gray-300">${build.description}</p>
                                        
                                        <div class="grid grid-cols-2 gap-4 text-sm">
                                            <div><strong>Version:</strong> ${build.version}</div>
                                            <div><strong>Size:</strong> ${build.size}</div>
                                            <div><strong>Released:</strong> ${new Date(build.releaseDate).toLocaleDateString()}</div>
                                            <div><strong>Category:</strong> ${build.category}</div>
                                        </div>
                                        
                                        <div>
                                            <h4 class="font-semibold mb-2">All Features:</h4>
                                            <ul class="space-y-1">
                                                ${build.features.map(feature => `
                                                    <li class="flex items-center text-sm">
                                                        <svg class="w-4 h-4 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
                                                            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                                                        </svg>
                                                        ${feature}
                                                    </li>
                                                `).join('')}
                                            </ul>
                                        </div>
                                        
                                        <div>
                                            <h4 class="font-semibold mb-2">System Requirements:</h4>
                                            <div class="text-sm space-y-1">
                                                <div><strong>RAM:</strong> ${build.requirements.ram}</div>
                                                <div><strong>Storage:</strong> ${build.requirements.storage}</div>
                                                <div><strong>Architecture:</strong> ${build.requirements.architecture}</div>
                                            </div>
                                        </div>
                                        
                                        <div class="flex space-x-4 pt-4">
                                            <a href="${build.downloadUrl}" class="bg-indigo-600 text-white px-6 py-3 rounded-lg hover:bg-indigo-700 transition-colors font-medium">
                                                Download ${build.title}
                                            </a>
                                            <div class="flex space-x-4 items-center text-sm">
                                                <a href="#" class="text-indigo-600 dark:text-indigo-400 hover:underline">Changelog</a>
                                                <a href="#" class="text-indigo-600 dark:text-indigo-400 hover:underline">SHA256</a>
                                                <a href="#" class="text-indigo-600 dark:text-indigo-400 hover:underline">GPG</a>
                                            </div>
                                        </div>
                                    </div>
                                `;
                                document.getElementById('download-modal').classList.remove('hidden');
                            }
                        }
                        
                        function closeDownloadModal() {
                            document.getElementById('download-modal').classList.add('hidden');
                        }
                        
                        // Close modal when clicking outside
                        document.getElementById('download-modal').addEventListener('click', function(e) {
                            if (e.target === this) {
                                closeDownloadModal();
                            }
                        });
                    </script>
                <% } else { %>
                    <!-- Fallback content if no downloads data -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                        <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg">
                            <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">GApps Build</h3>
                            <p class="text-gray-600 dark:text-gray-300 mb-4">Includes Google Play Store and services</p>
                            <a href="#" class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 transition-colors">Download</a>
                        </div>
                        <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg">
                            <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">FOSS Build</h3>
                            <p class="text-gray-600 dark:text-gray-300 mb-4">Open source alternatives only</p>
                            <a href="#" class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 transition-colors">Download</a>
                        </div>
                        <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg">
                            <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">Vanilla Build</h3>
                            <p class="text-gray-600 dark:text-gray-300 mb-4">Minimal installation</p>
                            <a href="#" class="bg-indigo-600 text-white px-6 py-2 rounded-lg hover:bg-indigo-700 transition-colors">Download</a>
                        </div>
                    </div>
                <% } %>
            </div>
            
            <div class="max-w-4xl mx-auto px-4 text-center">
                <p class="text-gray-700 dark:text-gray-300 mb-2">
                    *<a href="<%= downloads && downloads.metadata && downloads.metadata.documentationUrl ? downloads.metadata.documentationUrl : 'http://docs.blissos.org' %>" 
                        class="hover:text-indigo-600 dark:hover:text-indigo-500 underline" target="_blank">
                        Check our Documentation
                    </a> to see which devices these builds are supported on
                </p>
                <% if (downloads && downloads.metadata && downloads.metadata.supportedArchitectures) { %>
                    <p class="text-sm text-gray-600 dark:text-gray-400">
                        Supported Architectures: <%= downloads.metadata.supportedArchitectures.join(', ') %>
                    </p>
                <% } %>
            </div>
        </div>
    </main>

    <%- include('partials/footer') %>
</body>

</html>