<div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-lg hover:shadow-xl transition-shadow duration-300 h-full flex flex-col">
    <!-- Build Category Badge -->
    <% if (build.category === 'recommended') { %>
        <div class="inline-block bg-indigo-100 dark:bg-indigo-900 text-indigo-800 dark:text-indigo-200 text-xs font-semibold px-2 py-1 rounded-full mb-3 self-start">
            Recommended
        </div>
    <% } else if (build.category === 'privacy') { %>
        <div class="inline-block bg-green-100 dark:bg-green-900 text-green-800 dark:text-green-200 text-xs font-semibold px-2 py-1 rounded-full mb-3 self-start">
            Privacy Focused
        </div>
    <% } else if (build.category === 'minimal') { %>
        <div class="inline-block bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 text-xs font-semibold px-2 py-1 rounded-full mb-3 self-start">
            Minimal
        </div>
    <% } %>

    <!-- Build Title and Description -->
    <h3 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white"><%= build.title %></h3>
    <p class="text-gray-600 dark:text-gray-300 mb-4 flex-grow"><%= build.description %></p>

    <!-- Build Info -->
    <div class="mb-4 space-y-2">
        <div class="flex justify-between text-sm">
            <span class="text-gray-500 dark:text-gray-400">Version:</span>
            <span class="text-gray-900 dark:text-white font-medium"><%= build.version %></span>
        </div>
        <div class="flex justify-between text-sm">
            <span class="text-gray-500 dark:text-gray-400">Size:</span>
            <span class="text-gray-900 dark:text-white font-medium"><%= build.size %></span>
        </div>
    </div>

    <!-- Key Features (Limited) -->
    <div class="mb-6">
        <h4 class="text-sm font-semibold text-gray-700 dark:text-gray-300 mb-2">Key Features:</h4>
        <ul class="space-y-1">
            <% build.features.slice(0, 3).forEach(feature => { %>
                <li class="flex items-center text-sm text-gray-600 dark:text-gray-400">
                    <svg class="w-4 h-4 text-green-500 mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                    </svg>
                    <%= feature %>
                </li>
            <% }); %>
            <% if (build.features.length > 3) { %>
                <li class="text-xs text-gray-500 dark:text-gray-400 italic">
                    + <%= build.features.length - 3 %> more features
                </li>
            <% } %>
        </ul>
    </div>

    <!-- Download Button -->
    <div class="mt-auto">
        <% if (build.supported) { %>
            <a href="<%= build.downloadUrl %>" 
               class="block bg-indigo-600 text-white px-6 py-3 rounded-lg hover:bg-indigo-700 transition-colors text-center font-medium mb-3">
                Download <%= build.title %>
            </a>
        <% } else { %>
            <button disabled 
                    class="block w-full bg-gray-400 text-white px-6 py-3 rounded-lg cursor-not-allowed text-center font-medium mb-3">
                Currently Unavailable
            </button>
        <% } %>
        
        <!-- View Details Link -->
        <div class="text-center">
            <button onclick="showDownloadDetails('<%= build.id %>')" 
                    class="text-indigo-600 dark:text-indigo-400 hover:underline text-sm">
                View Full Details
            </button>
        </div>
    </div>
</div>