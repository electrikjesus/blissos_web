<div id="navbar" class="top-0 z-50 w-full sticky" style="transition: top 0.3s, background-color 0.3s; background-color: transparent;" x-data="{ open: false }" :class="{'shouldScroll': open}">
    <div class="flex flex-col max-w-full px-4 mx-auto md:items-center md:justify-between md:flex-row md:px-6 lg:px-8">
        <div class="flex flex-row items-center justify-between p-4">
            <a href="/" class="flex text-gray-100 transition duration-1000 ease-in-out group">
                <img id="bIcon"
                     src="/assets/images/pages/blissicon.svg"
                     class="transition-opacity h-9 w-9 group-focus:opacity-70"
                     alt="BlissOS Logo" />

                <div id="bTitle" class="mt-1 ml-3 text-xl font-black tracking-tight transition-colors group-hover:text-gray-400/60">
                    BlissOS</div>
            </a>
            <button class="rounded-lg md:hidden focus:outline-none focus:shadow-outline" @click="open = !open" role="navigation" aria-expanded="false" aria-label="Main" aria-controls="menuItems">
                <svg fill="currentColor" viewBox="0 0 20 20" class="w-6 h-6">
                    <path x-show="!open" fill-rule="evenodd"
                          d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM9 15a1 1 0 011-1h6a1 1 0 110 2h-6a1 1 0 01-1-1z"
                          clip-rule="evenodd"></path>
                    <path x-show="open" fill-rule="evenodd"
                          d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
                          clip-rule="evenodd"></path>
                </svg>
            </button>
        </div>
        <nav :class="{'flex': open, 'hidden': !open}"
             class="flex-col flex-grow pb-20 md:pb-0 md:flex md:justify-end md:flex-row" id="navi">
            <a class="px-4 py-2 mt-2 text-sm font-semibold rounded-lg md:mt-0 md:ml-4 hover:text-white focus:text-white hover:bg-indigo-600 focus:bg-indigo-700 focus:outline-none focus:shadow-outline"
               href="/#features">Features</a>
            <a class="px-4 py-2 mt-2 text-sm font-semibold rounded-lg md:mt-0 md:ml-4 hover:text-white focus:text-white hover:bg-indigo-600 focus:bg-indigo-700 focus:outline-none focus:shadow-outline"
               href="https://docs.blissos.org/" target="_blank">Docs</a>
               <a class="px-4 py-2 mt-2 text-sm font-semibold rounded-lg md:mt-0 md:ml-4 hover:text-white focus:text-white hover:bg-indigo-600 focus:bg-indigo-700 focus:outline-none focus:shadow-outline"
               href="https://blog.blissos.org/" target="_blank">Blog</a>
            <a class="px-4 py-2 mt-2 text-sm font-semibold rounded-lg md:mt-0 md:ml-4 hover:text-white focus:text-white hover:bg-indigo-600 focus:bg-indigo-700 focus:outline-none focus:shadow-outline"
               href="/licensing">Licensing</a>
            <button id="theme-toggle" type="button"
                    class="ml-2 p-2 text-sm text-gray-500 rounded-lg dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-gray-700 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 max-w-10 xs:hidden">
                <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20"
                     xmlns="http://www.w3.org/2000/svg">
                    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z">
                    </path>
                </svg>
                <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20"
                     aria-label="Dark or Light Mode" xmlns="http://www.w3.org/2000/svg">
                    <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z"
                          fill-rule="evenodd" clip-rule="evenodd"></path>
                </svg>
            </button>
        </nav>
    </div>
</div>

<script>
    let prevScrollpos = window.scrollY;
    let shouldrunscr = false;

    window.onresize = () => {
        if (window.innerWidth < 766 && document.querySelector('.shouldScroll')) {
            document.getElementById("navbar").style.top = "0";
        }
    };

    window.onscroll = () => {
        const currentScrollPos = window.scrollY;
        const currentWidth = window.innerWidth;
        shouldrunscr = currentWidth >= 766;

        if (!document.querySelector('.shouldScroll') || shouldrunscr) {
            document.getElementById("navbar").style.top = prevScrollpos > currentScrollPos ? "0" : "-80px";
        }

        const navbar = document.getElementById("navbar");
        const bTitle = document.getElementById("bTitle");
        const bIcon = document.getElementById("bIcon");

        if (currentScrollPos === 0) {
            navbar.style.backgroundColor = 'transparent';
            if (localStorage.getItem('color-theme') === 'dark') {
                navbar.style.color = 'white';
                bTitle.style.color = 'white';
                bIcon.style.filter = 'none';
            } else {
                navbar.style.color = 'rgb(17 24 39)';
                bTitle.style.color = 'rgb(17 24 39)';
                bIcon.style.filter = 'invert(8%) sepia(20%) saturate(1405%) hue-rotate(182deg) brightness(7%) contrast(97%)';
            }
        } else {
            navbar.style.backgroundColor = 'rgb(17, 24, 39)';
            navbar.style.color = 'rgb(229 231 235)';
            bTitle.style.color = 'rgb(229 231 235)';
            bIcon.style.filter = 'none';
        }
        prevScrollpos = currentScrollPos;
    };

    const updateNavbarColor = () => {
        const navbar = document.getElementById("navbar");
        const bTitle = document.getElementById("bTitle");
        const bIcon = document.getElementById("bIcon");

        if (window.scrollY === 0) {
            if (localStorage.getItem('color-theme') === 'dark') {
                navbar.style.color = 'white';
                bTitle.style.color = 'white';
                bIcon.style.filter = 'none';
            } else {
                navbar.style.color = 'rgb(17 24 39)';
                bTitle.style.color = 'rgb(17 24 39)';
                bIcon.style.filter = 'invert(8%) sepia(20%) saturate(1405%) hue-rotate(182deg) brightness(7%) contrast(97%)';
            }
        }
    };

    window.onclick = updateNavbarColor;
    window.onload = updateNavbarColor;
</script>